---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
import type { Database } from '../lib/database.types';
import { readEnv } from '../lib/sesiones';
import { PAQUETES, PRECIO_DESDE, DESCUENTO_ESTUDIANTE, formatMXN } from '../lib/precios';

const env = await readEnv();
const sb =
  env.PUBLIC_SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY
    ? createClient<Database>(env.PUBLIC_SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY, {
        auth: { persistSession: false, autoRefreshToken: false },
      })
    : null;

const { data: paquetes } = sb
  ? await sb
      .from('paquetes')
      .select('id, nombre, fotos_incluidas, duracion_min, looks, precio_base')
      .eq('activo', true)
      .order('orden')
  : { data: [] as any[] };

// Supabase manda el `id` (lo necesita el lead); lo que se muestra sale de
// precios.ts, que es la misma fuente que el home. Si un paquete de la base no
// existe en el catálogo público se muestra tal cual viene, sin precio.
const normaliza = (s: string) =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

const opciones = (paquetes ?? []).map((p) => {
  const publico = PAQUETES.find((x) => normaliza(x.nombre) === normaliza(p.nombre));
  return {
    id: p.id,
    nombre: publico?.nombre ?? p.nombre,
    fotos: publico?.fotos ?? p.fotos_incluidas,
    min: publico?.duracionMin ?? p.duracion_min,
    looks: publico?.looks ?? p.looks,
    precio: publico?.precio ?? (p.precio_base != null ? Number(p.precio_base) : null),
  };
});
---
<Layout
  title="Agendar Sesión | ANTE Estudio Fotográfico en Coyoacán"
  description="Agenda tu sesión de retrato en ANTE. Escríbenos por WhatsApp al +52 55 1238 8782, llámanos o déjanos tus datos: te contactamos en menos de 24 horas."
>
  <section class="agendar-hero" aria-label="Agendar sesión con ANTE">
    <p class="agendar-eyebrow">Agendar</p>
    <h1 class="agendar-title">Cuéntanos<br>de tu sesión</h1>
    <p class="agendar-sub">
      Escríbenos o llámanos y lo resolvemos en el momento. Si prefieres, déjanos tus datos
      en el formulario y te contactamos en menos de 24 horas.
    </p>
  </section>

  <section class="agendar-directo" aria-label="Contacto directo">
    <p class="directo-label">Lo más rápido</p>
    <div class="directo-opciones">
      <a
        class="directo-card"
        href="https://wa.me/525512388782?text=Hola%20ANTE%2C%20me%20gustar%C3%ADa%20agendar%20una%20sesi%C3%B3n."
        target="_blank"
        rel="noopener"
      >
        <span class="directo-tipo">WhatsApp</span>
        <span class="directo-dato">+52 55 1238 8782</span>
        <span class="directo-nota">Respuesta en menos de 24 horas</span>
      </a>
      <a class="directo-card" href="tel:+525512388782">
        <span class="directo-tipo">Llamar</span>
        <span class="directo-dato">+52 55 1238 8782</span>
        <span class="directo-nota">Lunes a sábado, 9:00 a 18:00</span>
      </a>
    </div>
  </section>

  <section class="agendar-form-wrap">
    <p class="agendar-form-label">O déjanos tus datos</p>
    <form id="leadForm" class="agendar-form">
      <div class="agendar-grid">
        <div class="form-row">
          <label for="nombre">Nombre completo *</label>
          <input id="nombre" name="nombre" type="text" required />
        </div>

        <div class="form-row">
          <label for="email">Correo *</label>
          <input id="email" name="email" type="email" required />
        </div>

        <div class="form-row">
          <label for="telefono">Teléfono / WhatsApp</label>
          <input id="telefono" name="telefono" type="tel" inputmode="tel" placeholder="+52 ..." />
        </div>

        <div class="form-row">
          <label for="ubicacion">Ciudad / ubicación</label>
          <input id="ubicacion" name="ubicacion" type="text" placeholder="CDMX, GDL..." />
        </div>

        <div class="form-row">
          <label for="fecha_preferida">Fecha preferida</label>
          <div class="date-picker-field" data-date-picker>
            <input
              id="fecha_preferida"
              name="fecha_preferida"
              type="date"
              inputmode="none"
              autocomplete="off"
              aria-describedby="fecha_preferida_note"
            />
            <button class="date-picker-button" type="button" aria-label="Abrir calendario" data-date-picker-button>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 2v3M17 2v3M4 9h16M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" />
              </svg>
            </button>
          </div>
          <p id="fecha_preferida_note" class="field-note">Mínimo 48 horas después de enviar este formulario.</p>
        </div>

        <div class="form-row">
          <label for="paquete">Paquete que te interesa</label>
          <select
            id="paquete"
            name="paquete_id"
            aria-describedby="paquete_note"
            data-paquetes={JSON.stringify(opciones)}
          >
            <option value="">— No estoy seguro —</option>
            {opciones.map((p) => (
              <option value={p.id}>
                {/* El precio va en segundo lugar: en móvil la opción se trunca. */}
                {p.nombre}
                {p.precio != null && ` · ${formatMXN(p.precio)}`}
                {` · ${p.fotos} fotos · ${p.min} min`}
              </option>
            ))}
          </select>
          <p id="paquete_note" class="field-note">
            Paquetes desde {formatMXN(PRECIO_DESDE)} MXN · <a href="/#precios">ver todos</a>
          </p>
        </div>

        <div class="form-row">
          <label for="origen">¿Cómo nos conociste?</label>
          <select id="origen" name="origen">
            <option value="">— Selecciona —</option>
            <option value="instagram">Instagram</option>
            <option value="referido">Referido</option>
            <option value="web">Web / Google</option>
            <option value="google">Búsqueda Google</option>
            <option value="tiktok">TikTok</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div class="form-row form-row-full">
          <label class="checkbox-row">
            <input id="es_estudiante" name="es_estudiante" type="checkbox" />
            <span>Soy estudiante ({DESCUENTO_ESTUDIANTE * 100}% de descuento en cualquier paquete, presentando credencial vigente)</span>
          </label>
        </div>

        <div class="form-row form-row-full">
          <label for="notas">¿Algo más que debamos saber?</label>
          <textarea id="notas" name="notas" rows="4" placeholder="Tipo de sesión, look, referencias visuales, ocasión..."></textarea>
        </div>
      </div>

      <button type="submit" class="agendar-submit">Enviar solicitud</button>
      <p id="formMsg" class="agendar-msg" aria-live="polite"></p>
    </form>
  </section>

  <style is:global>
    .agendar-hero {
      padding: 12rem 4rem 4rem;
      border-bottom: 0.5px solid rgba(245,242,237,0.1);
    }
    .agendar-eyebrow {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      color: var(--accent);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .agendar-eyebrow::before {
      content: '';
      display: block;
      width: 24px; height: 0.5px;
      background: var(--accent);
    }
    .agendar-title {
      font-family: var(--f-serif);
      font-size: clamp(3rem, 7vw, 5.5rem);
      font-weight: 700;
      line-height: 1.0;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
    }
    .agendar-sub {
      font-size: var(--fs-body);
      font-weight: 300;
      color: var(--mist);
      line-height: 1.85;
      max-width: 480px;
    }

    /* CONTACTO DIRECTO */
    .agendar-directo {
      padding: 4rem 4rem 0;
    }
    .directo-label,
    .agendar-form-label {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--ash);
      max-width: 880px;
      margin: 0 auto 1.6rem;
    }
    .directo-opciones {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      max-width: 880px;
      margin: 0 auto;
    }
    .directo-card {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 2rem;
      border: 0.5px solid rgba(245,242,237,0.18);
      text-decoration: none;
      transition: border-color 0.3s, background 0.3s;
    }
    .directo-card:hover {
      border-color: var(--accent);
      background: rgba(245,242,237,0.03);
    }
    .directo-tipo {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--accent);
    }
    .directo-dato {
      font-size: 1.15rem;
      font-weight: 300;
      color: var(--paper);
    }
    .directo-nota {
      font-size: var(--fs-micro);
      color: var(--ash);
      line-height: 1.6;
    }

    .agendar-form-wrap {
      padding: 4rem 4rem 6rem;
    }
    .agendar-form {
      max-width: 880px;
      margin: 0 auto;
    }
    .agendar-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem 2.4rem;
    }
    .form-row { display: flex; flex-direction: column; gap: 0.6rem; }
    .form-row-full { grid-column: 1 / -1; }
    .field-note {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      line-height: 1.6;
      text-transform: uppercase;
    }

    .agendar-form label {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-transform: uppercase;
    }
    .agendar-form input[type="text"],
    .agendar-form input[type="email"],
    .agendar-form input[type="tel"],
    .agendar-form input[type="date"],
    .agendar-form select,
    .agendar-form textarea {
      width: 100%;
      padding: 0.95rem 1rem;
      background: transparent;
      border: 0.5px solid rgba(245,242,237,0.2);
      color: var(--paper);
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      outline: none;
      transition: border-color 0.25s;
      resize: vertical;
    }
    .agendar-form input:focus,
    .agendar-form select:focus,
    .agendar-form textarea:focus {
      border-color: rgba(245,242,237,0.5);
    }
    .date-picker-field {
      position: relative;
      display: flex;
      align-items: center;
      border: 0.5px solid rgba(245,242,237,0.2);
      transition: border-color 0.25s;
    }
    .date-picker-field:focus-within {
      border-color: rgba(245,242,237,0.5);
    }
    .agendar-form .date-picker-field input[type="date"] {
      border: 0;
      padding-right: 3.6rem;
      cursor: pointer;
    }
    .agendar-form .date-picker-field input[type="date"]:focus {
      border-color: transparent;
    }
    .agendar-form .date-picker-field input[type="date"]::-webkit-calendar-picker-indicator {
      opacity: 0;
      cursor: pointer;
    }
    .date-picker-button {
      position: absolute;
      right: 0.9rem;
      width: 2.2rem;
      height: 2.2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0.5px solid rgba(245,242,237,0.16);
      background: transparent;
      color: var(--ash);
      cursor: pointer;
      transition: color 0.25s, border-color 0.25s;
    }
    .date-picker-button:hover {
      color: var(--paper);
      border-color: rgba(245,242,237,0.4);
    }
    .date-picker-button svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .agendar-form select option {
      background: var(--ink);
      color: var(--paper);
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      cursor: none;
    }
    .checkbox-row input[type="checkbox"] {
      width: auto;
      margin: 0;
      accent-color: var(--paper);
    }
    .checkbox-row span {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--mist);
      text-transform: none;
    }

    .agendar-submit {
      margin-top: 2.5rem;
      padding: 1.1rem 1.5rem;
      background: var(--paper);
      color: var(--ink);
      border: none;
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      text-transform: uppercase;
      cursor: none;
      transition: background 0.25s;
    }
    .agendar-submit:hover { background: var(--accent); }
    .agendar-submit:disabled { opacity: 0.5; pointer-events: none; }

    .agendar-msg {
      margin-top: 1.2rem;
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-transform: uppercase;
      min-height: 1.2em;
    }
    .agendar-msg.error { color: #e07070; }
    .agendar-msg.ok    { color: #a4c486; }

    @media (max-width: 768px) {
      .agendar-hero { padding: 9rem 1.5rem 3rem; }
      .agendar-directo { padding: 3rem 1.5rem 0; }
      .directo-opciones { grid-template-columns: 1fr; gap: 1rem; }
      .directo-card { padding: 1.5rem; }
      .agendar-form-wrap { padding: 3rem 1.5rem 4rem; }
      .agendar-grid { grid-template-columns: 1fr; gap: 1.6rem; }
    }
  </style>

  <script>
    const form = document.getElementById('leadForm') as HTMLFormElement;
    const msg = document.getElementById('formMsg') as HTMLParagraphElement;
    const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const fechaPreferida = document.getElementById('fecha_preferida') as HTMLInputElement | null;

    if (fechaPreferida) {
      const minDate = new Date();
      minDate.setDate(minDate.getDate() + 2);
      fechaPreferida.min = minDate.toISOString().slice(0, 10);

      const openDatePicker = () => {
        fechaPreferida.focus();
        if (typeof fechaPreferida.showPicker === 'function') {
          try {
            fechaPreferida.showPicker();
          } catch {
            // Algunos navegadores sólo permiten abrirlo durante una interacción directa.
          }
        }
      };

      document.querySelectorAll('[data-date-picker], [data-date-picker-button]').forEach((el) => {
        el.addEventListener('click', openDatePicker);
      });

      fechaPreferida.addEventListener('keydown', (event) => {
        if (!['Tab', 'Shift', 'Escape'].includes(event.key)) event.preventDefault();
      });
      fechaPreferida.addEventListener('paste', (event) => event.preventDefault());
      fechaPreferida.addEventListener('drop', (event) => event.preventDefault());
    }

    // Detalle del paquete elegido, debajo del selector. Reacciona también al
    // checkbox de estudiante para que el descuento se vea aplicado.
    const paqueteSel = document.getElementById('paquete');
    const paqueteNota = document.getElementById('paquete_note');
    const estudianteChk = document.getElementById('es_estudiante');

    if (paqueteSel && paqueteNota) {
      const notaInicial = paqueteNota.innerHTML;
      const catalogo = JSON.parse(paqueteSel.dataset.paquetes || '[]');
      const mxn = (n) => '$' + Number(n).toLocaleString('es-MX', { maximumFractionDigits: 0 });

      const pintarNota = () => {
        const p = catalogo.find((x) => x.id === paqueteSel.value);
        if (!p) {
          paqueteNota.innerHTML = notaInicial;
          return;
        }
        const partes = [
          `${p.fotos} fotos editadas`,
          `${p.min} min`,
          `${p.looks} ${p.looks === 1 ? 'look' : 'looks'}`,
        ];
        if (p.precio != null) {
          const esEstudiante = estudianteChk?.checked;
          const precio = esEstudiante ? Number(p.precio) * 0.5 : Number(p.precio);
          partes.push(esEstudiante ? `${mxn(precio)} con descuento de estudiante` : mxn(precio));
        }
        paqueteNota.textContent = partes.join(' · ') + ' · se aparta con 50% de anticipo.';
      };

      // Las tarjetas de /#precios enlazan con ?paquete=Nombre.
      const pedido = new URLSearchParams(location.search).get('paquete');
      if (pedido) {
        const match = catalogo.find(
          (x) => x.nombre.toLowerCase() === pedido.toLowerCase(),
        );
        if (match) paqueteSel.value = match.id;
      }

      paqueteSel.addEventListener('change', pintarNota);
      estudianteChk?.addEventListener('change', pintarNota);
      pintarNota();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'agendar-msg';

      const fd = new FormData(form);
      const payload = {
        nombre: String(fd.get('nombre') ?? ''),
        email: String(fd.get('email') ?? ''),
        telefono: String(fd.get('telefono') ?? ''),
        handle_ig: String(fd.get('handle_ig') ?? ''),
        ubicacion: String(fd.get('ubicacion') ?? ''),
        fecha_preferida: String(fd.get('fecha_preferida') ?? ''),
        paquete_id: String(fd.get('paquete_id') ?? ''),
        origen: String(fd.get('origen') ?? ''),
        es_estudiante: fd.get('es_estudiante') === 'on',
        notas: String(fd.get('notas') ?? ''),
      };

      submit.disabled = true;
      submit.textContent = 'Enviando...';

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          msg.textContent = j.error ?? 'No se pudo enviar';
          msg.className = 'agendar-msg error';
          submit.disabled = false;
          submit.textContent = 'Enviar solicitud';
          return;
        }
        msg.textContent = 'Listo. Te contactamos pronto.';
        msg.className = 'agendar-msg ok';
        form.reset();
        submit.textContent = 'Enviado';
      } catch (err) {
        msg.textContent = String(err);
        msg.className = 'agendar-msg error';
        submit.disabled = false;
        submit.textContent = 'Enviar solicitud';
      }
    });
  </script>
</Layout>
