<style is:global>
  .schedule-trigger {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .schedule-modal {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .schedule-modal[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  .schedule-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(13,13,11,0.74);
    backdrop-filter: blur(10px);
  }
  .schedule-dialog {
    position: relative;
    width: min(100%, 460px);
    padding: 3rem;
    border: 0.5px solid rgba(245,242,237,0.18);
    background: rgba(28,27,24,0.94);
    box-shadow: 0 24px 90px rgba(0,0,0,0.42);
    transform: translateY(16px);
    transition: transform 0.25s ease;
  }
  .schedule-modal[data-open] .schedule-dialog {
    transform: translateY(0);
  }
  .schedule-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2rem;
    height: 2rem;
    border: 0.5px solid rgba(245,242,237,0.16);
    background: transparent;
    color: var(--ash);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .schedule-close:hover {
    color: var(--paper);
    border-color: rgba(245,242,237,0.35);
  }
  .schedule-kicker {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-wide);
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .schedule-title {
    font-family: var(--f-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--paper);
    margin-bottom: 1.25rem;
  }
  .schedule-copy {
    font-size: var(--fs-body);
    font-weight: 300;
    line-height: 1.85;
    color: var(--mist);
    margin-bottom: 2rem;
  }
  .schedule-actions {
    display: grid;
    gap: 0.9rem;
  }
  .schedule-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1rem 1.1rem;
    border: 0.5px solid rgba(245,242,237,0.16);
    color: var(--paper);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .schedule-option span {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    font-weight: 300;
    letter-spacing: var(--ls-label);
    color: var(--ash);
    text-transform: uppercase;
    text-align: right;
  }
  .schedule-option:hover {
    transform: translateY(-1px);
    border-color: rgba(245,242,237,0.38);
    background: rgba(245,242,237,0.035);
  }
  .schedule-option-primary {
    color: var(--ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .schedule-option-primary span {
    color: rgba(13,13,11,0.64);
  }
  .schedule-option-primary:hover {
    background: var(--paper);
  }
  @media (max-width: 540px) {
    .schedule-dialog { padding: 2.4rem 1.4rem 1.4rem; }
    .schedule-option {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }
    .schedule-option span { text-align: left; }
  }

  /* ── FAQ Accordion ── */
  .faq-acc-section {
    padding: 0 4rem 7rem;
    border-top: 0.5px solid rgba(245,242,237,0.08);
  }
  .faq-acc-header { padding: 6rem 0 3rem; }
  .faq-acc-list { border-top: 0.5px solid rgba(245,242,237,0.08); }
  .faq-acc-item { border-bottom: 0.5px solid rgba(245,242,237,0.08); }
  .faq-acc-trigger {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: 100%;
    padding: 2.2rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    position: relative;
  }
  .faq-acc-trigger::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(245,242,237,0.018);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .faq-acc-trigger:hover::before { opacity: 1; }
  .faq-acc-num {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-wide);
    color: rgba(154,150,144,0.4);
    flex-shrink: 0;
    min-width: 2rem;
    transition: color 0.35s ease;
    user-select: none;
  }
  .faq-acc-trigger:hover .faq-acc-num,
  .faq-acc-item[data-open] .faq-acc-num { color: var(--accent); }
  .faq-acc-q {
    font-family: var(--f-sans);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    font-weight: 300;
    letter-spacing: 0.01em;
    color: var(--ash);
    flex: 1;
    line-height: 1.5;
    transition: color 0.35s ease;
  }
  .faq-acc-trigger:hover .faq-acc-q,
  .faq-acc-item[data-open] .faq-acc-q { color: var(--paper); }
  .faq-acc-icon {
    flex-shrink: 0;
    font-family: var(--f-sans);
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--ash);
    line-height: 1;
    width: 1.5rem;
    text-align: center;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), color 0.35s ease;
    user-select: none;
  }
  .faq-acc-trigger:hover .faq-acc-icon { color: var(--paper); }
  .faq-acc-item[data-open] .faq-acc-icon { transform: rotate(45deg); color: var(--paper); }
  /* Smooth height animation via CSS grid */
  .faq-acc-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq-acc-item[data-open] .faq-acc-body { grid-template-rows: 1fr; }
  .faq-acc-body-inner { overflow: hidden; }
  .faq-acc-answer {
    padding: 0 0 2.5rem calc(2rem + 2rem);
    font-size: var(--fs-body);
    font-weight: 300;
    line-height: 1.95;
    color: var(--mist);
    max-width: 600px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .faq-acc-item[data-open] .faq-acc-answer { opacity: 1; transform: translateY(0); }
  @media (max-width: 768px) {
    .faq-acc-section { padding: 0 1.5rem 5rem; }
    .faq-acc-header { padding: 5rem 0 2rem; }
    .faq-acc-trigger { gap: 1.2rem; padding: 1.8rem 0; }
    .faq-acc-answer { padding-left: calc(1.2rem + 1.2rem); }
  }
</style>

<script is:inline>
  (function () {
    var valores = document.querySelector('.valores');
    if (!valores) return;
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        e.target.classList.toggle('valores--in', e.isIntersecting);
      });
    }, { threshold: 0.1 }).observe(valores);
  })();
</script>

<script is:inline>
(function () {
  var modal = document.querySelector('[data-schedule-modal]');
  var triggers = document.querySelectorAll('[data-schedule-trigger]');
  var closeButtons = document.querySelectorAll('[data-schedule-close]');
  var lastFocus = null;

  function openScheduleModal() {
    if (!modal) return;
    lastFocus = document.activeElement;
    modal.setAttribute('data-open', '');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    var firstLink = modal.querySelector('.schedule-option');
    if (firstLink) firstLink.focus();
  }

  function closeScheduleModal() {
    if (!modal) return;
    modal.removeAttribute('data-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  triggers.forEach(function (trigger) {
    trigger.addEventListener('click', openScheduleModal);
  });

  closeButtons.forEach(function (button) {
    button.addEventListener('click', closeScheduleModal);
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && modal && modal.hasAttribute('data-open')) {
      closeScheduleModal();
    }
  });

  var items = document.querySelectorAll('[data-faq]');
  items.forEach(function (item) {
    var trigger = item.querySelector('.faq-acc-trigger');
    var body    = item.querySelector('.faq-acc-body');
    trigger.addEventListener('click', function () {
      var isOpen = item.hasAttribute('data-open');
      items.forEach(function (i) {
        i.removeAttribute('data-open');
        i.querySelector('.faq-acc-trigger').setAttribute('aria-expanded', 'false');
        i.querySelector('.faq-acc-body').setAttribute('aria-hidden', 'true');
      });
      if (!isOpen) {
        item.setAttribute('data-open', '');
        trigger.setAttribute('aria-expanded', 'true');
        body.setAttribute('aria-hidden', 'false');
      }
    });
  });
})();
</script>

</Layout>
