---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { getSesionByCodigo, fotoUrl, readEnv } from '../../../lib/sesiones';
import { requireAdmin } from '../../../lib/admin-auth';
import { runDueArchives, diasParaArchivar } from '../../../lib/archivado';
import '../../../styles/admin.css';

const env = await readEnv();
const auth = await requireAdmin(env, Astro.request);
if (!auth.ok) return Astro.redirect('/admin/login', 302);

await runDueArchives(env);

const { codigo } = Astro.params;
const codigoNorm = (codigo ?? '').toUpperCase();
const data = codigoNorm ? await getSesionByCodigo(env, codigoNorm) : null;
if (!data) return Astro.redirect('/admin?err=no-encontrado', 302);

const { sesion, paquete, fotosFinales, fotosPreview, selecciones } = data;
const seleccionadas = new Set(selecciones.map((s) => s.foto_id));
const limite = sesion.limite_fotos ?? paquete?.fotos_incluidas ?? 0;

const fotosFinalesPrincipales = fotosFinales.filter((f) => !f.parent_foto_id);
const altByParent: Record<string, typeof fotosFinales[number]> = {};
for (const f of fotosFinales) {
  if (f.parent_foto_id) altByParent[f.parent_foto_id] = f;
}
const diasRestantes = sesion.estado === 'entregada' ? diasParaArchivar(sesion.fecha_entrega) : null;

const precioCalculado =
  (paquete?.precio_base ? Number(paquete.precio_base) : 0) +
  (sesion.monto_extras ? Number(sesion.monto_extras) : 0);

const estadoLabel: Record<string, string> = {
  lead: 'Lead',
  seleccion: 'Seleccionando',
  pago_pendiente: 'Pago pendiente',
  editando: 'Editando',
  entregada: 'Entregada',
  archivada: 'Archivada',
};
---
<Layout title={`${sesion.codigo} · Admin · ANTE`} noindex={true}>
  <main class="admin-main">
    <a href="/admin" class="back-link">← Clientes</a>
    <header class="admin-header">
      <div>
        <p class="admin-eyebrow">Cliente</p>
        <h1 class="admin-h1">{sesion.nombre_cliente}</h1>
        <p class="admin-sub">
          Código <span class="mono">{sesion.codigo}</span>
          {paquete && ` · Paquete ${paquete.nombre} · ${limite} fotos`}
        </p>
      </div>
      <div class="admin-actions">
        <span class={`badge badge-${sesion.estado}`}>{estadoLabel[sesion.estado]}</span>
        <a href={`/clientes/${sesion.codigo}`} target="_blank" rel="noopener" class="btn-link">
          Ver como cliente ↗
        </a>
      </div>
    </header>

    <section class="admin-block">
      <h2 class="admin-h2">Estado</h2>
      <div class="estado-controls">
        <select id="estadoSelect">
          <option value="seleccion" selected={sesion.estado === 'seleccion'}>Seleccionando</option>
          <option value="pago_pendiente" selected={sesion.estado === 'pago_pendiente'}>Pago pendiente</option>
          <option value="editando" selected={sesion.estado === 'editando'}>Editando</option>
          <option value="entregada" selected={sesion.estado === 'entregada'}>Entregada</option>
        </select>
        <button id="btnCambiarEstado" type="button" class="btn-ghost">Cambiar estado</button>
      </div>
      <p class="form-hint">
        Recuerda: la página del cliente cambia según este estado. Pasa a "Editando" cuando recibas el pago de extras (si los hay), y a "Entregada" cuando subas las fotos finales.
      </p>

      {sesion.estado === 'entregada' && diasRestantes !== null && (
        <div class="archive-warn">
          {diasRestantes > 0
            ? <p>Las fotos se archivarán automáticamente en <strong>{diasRestantes} día{diasRestantes !== 1 ? 's' : ''}</strong> (30 días desde la entrega). Después se borran de R2 y solo queda la info histórica.</p>
            : <p>Esta sesión cumplió ya 30 días desde la entrega. Se archivará en el próximo refresh, o puedes archivarla manualmente abajo.</p>}
          <button id="btnArchivar" type="button" class="btn-ghost btn-danger">Archivar y borrar fotos ahora</button>
        </div>
      )}
      {sesion.estado === 'archivada' && (
        <p class="archive-info">
          Esta sesión está <strong>archivada</strong>. Las fotos se borraron el {sesion.fecha_archivado ? new Date(sesion.fecha_archivado).toLocaleDateString('es-MX') : '—'}. Solo queda el histórico.
        </p>
      )}
    </section>

    <section class="admin-block">
      <h2 class="admin-h2">Pago y precio</h2>
      <div class="precio-row">
        <div class="precio-info">
          <p class="form-hint">
            Calculado: paquete{paquete?.precio_base ? ` $${Number(paquete.precio_base)}` : ' (sin precio)'}{sesion.monto_extras ? ` + extras $${Number(sesion.monto_extras)}` : ''} = <strong>${precioCalculado} MXN</strong>
          </p>
        </div>
        <div class="precio-controls">
          <label for="precioFinalInput">Precio final manual (override)</label>
          <input
            id="precioFinalInput"
            type="number"
            step="0.01"
            min="0"
            value={sesion.precio_final ?? ''}
            placeholder="vacío = usar calculado"
          />
          <button id="btnPrecioFinal" type="button" class="btn-ghost">Guardar</button>
        </div>
      </div>

      <h3 class="admin-h3">Comprobante de anticipo (50%)</h3>
      {sesion.comprobante_50_url ? (
        <div class="comprobante-actual">
          <a href={sesion.comprobante_50_url} target="_blank" rel="noopener" class="btn-link">
            Ver comprobante actual ↗
          </a>
          <button id="btnQuitarComprobante" type="button" class="btn-link" style="color:#e07070">Quitar</button>
        </div>
      ) : (
        <p class="form-hint">Aún sin comprobante. Sube la imagen/PDF que te mandó el cliente.</p>
      )}
      <div id="comprobanteDropzone" class="dropzone" style="margin-top:1rem">
        <p class="dropzone-text">Arrastra el comprobante aquí o haz click</p>
        <p class="dropzone-sub">JPG, PNG o PDF · se sube directo a R2 + Notion</p>
        <input id="comprobanteInput" type="file" accept="image/jpeg,image/png,application/pdf" hidden />
      </div>
      <p id="comprobanteMsg" class="form-msg" aria-live="polite"></p>
    </section>

    <section class="admin-block">
      <h2 class="admin-h2">Fotos preview ({fotosPreview.length})</h2>
      <p class="form-hint">Las que el cliente ve para seleccionar. Con marca de agua, baja resolución.</p>

      {fotosPreview.length === 0 ? (
        <p class="empty-block">Sin fotos preview todavía.</p>
      ) : (
        <div class="thumb-grid">
          {fotosPreview.map((foto) => (
            <figure class={`thumb ${seleccionadas.has(foto.id) ? 'selected' : ''}`}>
              <img src={fotoUrl(env, foto.r2_key)} alt={foto.original_filename ?? ''} loading="lazy" />
              {seleccionadas.has(foto.id) && <span class="thumb-mark">SELECCIONADA</span>}
              <figcaption>{foto.original_filename}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </section>

    <section class="admin-block">
      <h2 class="admin-h2">
        Fotos finales ({fotosFinalesPrincipales.length})
        {Object.keys(altByParent).length > 0 && (
          <span class="admin-h2-aux"> · {Object.keys(altByParent).length} con subversión</span>
        )}
      </h2>
      <p class="form-hint">JPG en alta calidad sin marca de agua. Visibles para el cliente solo cuando estado = "Entregada".</p>

      <div id="finalDropzone" class="dropzone">
        <p class="dropzone-text">Arrastra las fotos finales editadas aquí</p>
        <p class="dropzone-sub">Se procesarán a 2400px JPG calidad alta</p>
        <input id="finalFileInput" type="file" accept="image/jpeg,image/png" multiple hidden />
      </div>
      <ul id="finalFileList" class="file-list"></ul>
      <button id="btnSubirFinales" type="button" class="btn-primary" style="margin-top:1rem;display:none">Subir fotos finales</button>
      <p id="finalMsg" class="form-msg" aria-live="polite"></p>

      {fotosFinalesPrincipales.length > 0 && (
        <div class="thumb-grid" style="margin-top: 1.5rem">
          {fotosFinalesPrincipales.map((foto) => {
            const alt = altByParent[foto.id];
            return (
              <figure class="thumb thumb-final">
                <div class="thumb-final-frame">
                  <img src={fotoUrl(env, foto.r2_key)} alt={foto.original_filename ?? ''} loading="lazy" />
                  {alt && (
                    <img
                      class="thumb-alt-overlay"
                      src={fotoUrl(env, alt.r2_key)}
                      alt={`Alt · ${alt.original_filename ?? ''}`}
                      loading="lazy"
                    />
                  )}
                </div>
                <figcaption>{foto.original_filename}</figcaption>
                <div class="alt-controls">
                  <button type="button" class="btn-alt-upload" data-foto-id={foto.id}>
                    {alt ? 'Reemplazar alternativa' : '+ Versión alternativa'}
                  </button>
                  {alt && (
                    <span class="alt-meta">alt: {alt.original_filename}</span>
                  )}
                </div>
              </figure>
            );
          })}
        </div>
      )}
      <input id="altFileInput" type="file" accept="image/jpeg,image/png" hidden />
      <p id="altMsg" class="form-msg" aria-live="polite"></p>
    </section>

    <section class="admin-block">
      <h2 class="admin-h2">Selección del cliente</h2>
      {selecciones.length === 0 ? (
        <p class="empty-block">El cliente aún no ha seleccionado fotos.</p>
      ) : (
        <ul class="selection-list">
          {selecciones.map((s) => {
            const foto = fotosPreview.find((f) => f.id === s.foto_id) ?? fotosFinales.find((f) => f.id === s.foto_id);
            return (
              <li>
                <span class="mono">{foto?.original_filename ?? s.foto_id}</span>
                {s.nota && <span class="nota">"{s.nota}"</span>}
              </li>
            );
          })}
        </ul>
      )}

      {selecciones.length > limite && limite > 0 && (
        <p class="extras-info">
          {selecciones.length - limite} foto{selecciones.length - limite !== 1 ? 's' : ''} extra ·
          <strong> ${(selecciones.length - limite) * Number(sesion.precio_extra)} MXN</strong>
        </p>
      )}
    </section>

  </main>

  <script src="/js/image-processor.js" is:inline></script>
  <script define:vars={{ codigo: sesion.codigo }}>
    // Precio final manual
    const precioFinalInput = document.getElementById('precioFinalInput');
    const btnPrecioFinal = document.getElementById('btnPrecioFinal');
    btnPrecioFinal?.addEventListener('click', async () => {
      const raw = precioFinalInput.value.trim();
      btnPrecioFinal.disabled = true;
      btnPrecioFinal.textContent = 'Guardando...';
      try {
        const res = await fetch('/admin/api/precio-final', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ codigo, precio_final: raw === '' ? null : Number(raw) }),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          alert(j.error || 'Error guardando precio');
        } else {
          btnPrecioFinal.textContent = 'Guardado ✓';
          setTimeout(() => { btnPrecioFinal.textContent = 'Guardar'; }, 1500);
        }
      } catch (e) {
        alert(String(e));
      } finally {
        btnPrecioFinal.disabled = false;
      }
    });

    // Comprobante 50%
    const compDz = document.getElementById('comprobanteDropzone');
    const compInput = document.getElementById('comprobanteInput');
    const compMsg = document.getElementById('comprobanteMsg');
    const btnQuitarComp = document.getElementById('btnQuitarComprobante');

    async function uploadComprobante(file) {
      compMsg.textContent = `Subiendo ${file.name}...`;
      compMsg.className = 'form-msg';
      const fd = new FormData();
      fd.set('codigo', codigo);
      fd.set('file', file);
      try {
        const res = await fetch('/admin/api/upload-comprobante', { method: 'POST', body: fd });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          compMsg.textContent = j.error || 'Error subiendo';
          compMsg.className = 'form-msg error';
          return;
        }
        compMsg.textContent = 'Subido ✓';
        compMsg.className = 'form-msg ok';
        setTimeout(() => window.location.reload(), 800);
      } catch (e) {
        compMsg.textContent = String(e);
        compMsg.className = 'form-msg error';
      }
    }

    compDz?.addEventListener('click', () => compInput.click());
    compDz?.addEventListener('dragover', (e) => { e.preventDefault(); compDz.classList.add('drag-over'); });
    compDz?.addEventListener('dragleave', () => compDz.classList.remove('drag-over'));
    compDz?.addEventListener('drop', (e) => {
      e.preventDefault();
      compDz.classList.remove('drag-over');
      const f = e.dataTransfer?.files?.[0];
      if (f) uploadComprobante(f);
    });
    compInput?.addEventListener('change', () => {
      const f = compInput.files?.[0];
      if (f) uploadComprobante(f);
    });

    btnQuitarComp?.addEventListener('click', async () => {
      if (!confirm('¿Quitar el comprobante? El archivo queda en R2 pero deja de mostrarse en Notion y en este admin.')) return;
      const fd = new FormData();
      fd.set('codigo', codigo);
      fd.set('remove', '1');
      try {
        const res = await fetch('/admin/api/upload-comprobante', { method: 'POST', body: fd });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          alert(j.error || 'Error');
          return;
        }
        window.location.reload();
      } catch (e) {
        alert(String(e));
      }
    });

    // Archivar manual
    const btnArchivar = document.getElementById('btnArchivar');
    if (btnArchivar) {
      btnArchivar.addEventListener('click', async () => {
        if (!confirm('¿Archivar esta sesión? Se borrarán todas las fotos (preview y finales) de R2. Esta acción no se puede deshacer. La info del cliente y la selección histórica se conservan.')) return;
        btnArchivar.disabled = true;
        btnArchivar.textContent = 'Archivando...';
        try {
          const res = await fetch('/admin/api/archivar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ codigo }),
          });
          const j = await res.json().catch(() => ({}));
          if (!res.ok) {
            alert(j.error || 'Error archivando');
            btnArchivar.disabled = false;
            btnArchivar.textContent = 'Archivar y borrar fotos ahora';
            return;
          }
          window.location.reload();
        } catch (e) {
          alert(String(e));
          btnArchivar.disabled = false;
          btnArchivar.textContent = 'Archivar y borrar fotos ahora';
        }
      });
    }

    // Cambiar estado
    const estadoSelect = document.getElementById('estadoSelect');
    const btnCambiar = document.getElementById('btnCambiarEstado');
    btnCambiar.addEventListener('click', async () => {
      const nuevo = estadoSelect.value;
      btnCambiar.disabled = true;
      btnCambiar.textContent = 'Cambiando...';
      try {
        const res = await fetch('/admin/api/cambiar-estado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ codigo, estado: nuevo }),
        });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          alert(j.error || 'Error cambiando estado');
        } else {
          window.location.reload();
        }
      } catch (e) {
        alert(String(e));
      } finally {
        btnCambiar.disabled = false;
        btnCambiar.textContent = 'Cambiar estado';
      }
    });

    // Drag & drop fotos finales
    const dropzone = document.getElementById('finalDropzone');
    const fileInput = document.getElementById('finalFileInput');
    const fileList = document.getElementById('finalFileList');
    const btnSubir = document.getElementById('btnSubirFinales');
    const msg = document.getElementById('finalMsg');
    const archivos = [];

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('drag-over'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('drag-over'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-over');
      addFiles(Array.from(e.dataTransfer.files));
    });
    fileInput.addEventListener('change', () => addFiles(Array.from(fileInput.files)));

    function addFiles(files) {
      for (const f of files) {
        if (!f.type.startsWith('image/')) continue;
        if (archivos.some((a) => a.name === f.name && a.size === f.size)) continue;
        archivos.push(f);
      }
      render();
    }

    function render() {
      fileList.innerHTML = '';
      archivos.forEach((f, i) => {
        const li = document.createElement('li');
        li.id = `final-file-${i}`;
        li.innerHTML = `<span>${f.name} · ${(f.size / 1024 / 1024).toFixed(1)} MB</span><span class="file-status">Pendiente</span>`;
        fileList.appendChild(li);
      });
      btnSubir.style.display = archivos.length > 0 ? '' : 'none';
    }

    function setStatus(i, txt, cls = '') {
      const el = document.querySelector(`#final-file-${i} .file-status`);
      if (el) { el.textContent = txt; el.className = `file-status ${cls}`; }
    }

    btnSubir.addEventListener('click', async () => {
      btnSubir.disabled = true;
      btnSubir.textContent = 'Subiendo...';
      msg.textContent = '';
      msg.className = 'form-msg';
      let ok = 0, fail = 0;
      for (let i = 0; i < archivos.length; i++) {
        const file = archivos[i];
        try {
          setStatus(i, 'Procesando...');
          const blob = await window.imageProcessor.generaFinal(file);
          setStatus(i, 'Subiendo...');
          const fd = new FormData();
          fd.set('codigo', codigo);
          fd.set('tipo', 'final');
          fd.set('orden', String(i + 1));
          fd.set('file', new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' }));
          const res = await fetch('/admin/api/upload', { method: 'POST', body: fd });
          if (!res.ok) {
            const j = await res.json().catch(() => ({}));
            throw new Error(j.error || `HTTP ${res.status}`);
          }
          setStatus(i, 'Listo', 'ok');
          ok++;
        } catch (err) {
          setStatus(i, 'Error', 'error');
          console.error(err);
          fail++;
        }
      }
      msg.textContent = `${ok} subidas${fail ? `, ${fail} fallidas` : ''}.`;
      msg.className = `form-msg ${fail ? 'error' : 'ok'}`;
      btnSubir.disabled = false;
      btnSubir.textContent = 'Subir fotos finales';
      if (fail === 0) setTimeout(() => window.location.reload(), 1200);
    });

    // ─── Subir versión alternativa por foto final ─────────────
    const altInput = document.getElementById('altFileInput');
    const altMsg = document.getElementById('altMsg');
    let altTargetFotoId = null;

    document.querySelectorAll('.btn-alt-upload').forEach((btn) => {
      btn.addEventListener('click', () => {
        altTargetFotoId = btn.dataset.fotoId;
        altInput.value = '';
        altInput.click();
      });
    });

    altInput?.addEventListener('change', async () => {
      const file = altInput.files?.[0];
      if (!file || !altTargetFotoId) return;
      altMsg.textContent = `Procesando ${file.name}...`;
      altMsg.className = 'form-msg';
      try {
        const blob = await window.imageProcessor.generaFinal(file);
        altMsg.textContent = `Subiendo alternativa...`;
        const fd = new FormData();
        fd.set('codigo', codigo);
        fd.set('tipo', 'final');
        fd.set('orden', '0');
        fd.set('parent_id', altTargetFotoId);
        fd.set('file', new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' }));
        const res = await fetch('/admin/api/upload', { method: 'POST', body: fd });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          altMsg.textContent = j.error || 'Error subiendo alternativa';
          altMsg.className = 'form-msg error';
          return;
        }
        altMsg.textContent = 'Alternativa subida ✓';
        altMsg.className = 'form-msg ok';
        setTimeout(() => window.location.reload(), 800);
      } catch (e) {
        altMsg.textContent = String(e);
        altMsg.className = 'form-msg error';
      }
    });
  </script>
</Layout>
