---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getSesionByCodigo, fotoUrl, readEnv } from '../../lib/sesiones';

const { codigo } = Astro.params;
const codigoNormalizado = (codigo ?? '').toUpperCase();

const env = await readEnv();

let data: Awaited<ReturnType<typeof getSesionByCodigo>> = null;
let errorDetalle: string | null = null;

try {
  data = codigoNormalizado ? await getSesionByCodigo(env, codigoNormalizado) : null;
} catch (err) {
  errorDetalle = err instanceof Error ? `${err.name}: ${err.message}` : String(err);
  console.error('[/clientes/[codigo]]', errorDetalle);
}

if (errorDetalle) {
  return new Response(`Error cargando sesión: ${errorDetalle}`, {
    status: 500,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

if (!data) {
  return Astro.redirect('/clientes?err=no-encontrado', 302);
}

const { sesion, paquete, fotosFinales, fotosPreview, selecciones } = data;
const seleccionadas = new Set(selecciones.map((s) => s.foto_id));
const limite = sesion.limite_fotos ?? paquete?.fotos_incluidas ?? 0;
const seleccionadasCount = selecciones.length;
const extras = Math.max(0, seleccionadasCount - limite);
const costoExtras = extras * Number(sesion.precio_extra ?? 0);

const fotosFinalesPrincipales = fotosFinales.filter((f) => !f.parent_foto_id);
const altByParent: Record<string, typeof fotosFinales[number]> = {};
for (const f of fotosFinales) {
  if (f.parent_foto_id) altByParent[f.parent_foto_id] = f;
}

const fotosParaSeleccion = fotosPreview.length > 0 ? fotosPreview : fotosFinalesPrincipales;

const WHATSAPP = '525512388782';
const waPagoUrl = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(
  `Hola, mi código es ${sesion.codigo} y quiero los datos de pago.`,
)}`;
const waArchivadaUrl = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(
  `Hola, mi galería de ANTE fue archivada y me gustaría reactivarla. Mi código es ${sesion.codigo}`,
)}`;
const mailArchivadaUrl = `mailto:contacto@ante.photo?subject=${encodeURIComponent(
  `Reactivar galería ${sesion.codigo}`,
)}`;
---
<Layout
  title={`Galería · ${sesion.nombre_cliente} | ANTE`}
  noindex={true}
>
  <main class="cliente-main">
    <section class="cliente-intro">
      <p class="cliente-eyebrow">Galería privada</p>
      <h1 class="cliente-name">{sesion.nombre_cliente}</h1>
      {paquete && (
        <p class="cliente-paquete">
          Paquete {paquete.nombre} · {paquete.fotos_incluidas} fotos · {paquete.looks} look{paquete.looks > 1 ? 's' : ''}
        </p>
      )}
    </section>

    {sesion.estado === 'entregada' && (
      <section class="estado-entregada" data-fotos-count={fotosFinalesPrincipales.length}>
        <p class="estado-texto">
          Tus fotos están listas. Da click en cualquiera para verla en grande, o en el ícono de descarga.
        </p>

        <div class="galeria-grid">
          {fotosFinalesPrincipales.map((foto, i) => {
            const alt = altByParent[foto.id];
            return (
              <figure class="galeria-item" data-index={i}>
                <div class="galeria-frame">
                  <img
                    src={fotoUrl(env, foto.r2_key)}
                    alt={`${sesion.nombre_cliente} – foto ${i + 1}`}
                    loading="lazy"
                    draggable="false"
                    data-full={fotoUrl(env, foto.r2_key)}
                  />
                  {alt && (
                    <img
                      class="galeria-alt"
                      src={fotoUrl(env, alt.r2_key)}
                      alt={`${sesion.nombre_cliente} – foto ${i + 1} (versión alterna)`}
                      loading="lazy"
                      draggable="false"
                      data-full={fotoUrl(env, alt.r2_key)}
                      title="Versión alterna · click para verla en grande"
                    />
                  )}
                  <a
                    class="galeria-download"
                    href={fotoUrl(env, foto.r2_key)}
                    download={foto.original_filename ?? `${sesion.codigo}_${i + 1}.jpg`}
                    aria-label="Descargar foto"
                    onclick="event.stopPropagation()"
                  >
                    ↓
                  </a>
                  {alt && (
                    <a
                      class="galeria-download galeria-download-alt"
                      href={fotoUrl(env, alt.r2_key)}
                      download={alt.original_filename ?? `${sesion.codigo}_${i + 1}_alt.jpg`}
                      aria-label="Descargar versión alterna"
                      onclick="event.stopPropagation()"
                    >
                      ↓
                    </a>
                  )}
                </div>
                <figcaption class="galeria-caption">
                  {String(i + 1).padStart(2, '0')} / {String(fotosFinalesPrincipales.length).padStart(2, '0')}
                  {alt && <span class="galeria-caption-alt"> · alt incluida</span>}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )}

    {sesion.estado === 'seleccion' && (
      <section
        class="estado-seleccion"
        data-sesion-id={sesion.id}
        data-limite={limite}
        data-precio-extra={sesion.precio_extra}
      >
        <div class="seleccion-status">
          <p class="seleccion-instructions">
            Elige tus fotos favoritas. Tu paquete incluye <strong>{limite}</strong>.
            Si quieres más, cada foto extra cuesta <strong>${sesion.precio_extra} MXN</strong>.
          </p>

          <div class="contador-bar">
            <div class="contador-label">
              Seleccionadas:
              <span id="contadorActual">{seleccionadasCount}</span>
              /
              <span>{limite}</span>
            </div>
            <div id="extrasInfo" class="contador-extras" style={extras > 0 ? '' : 'display:none'}>
              <span id="extrasCount">{extras}</span> extra{extras !== 1 ? 's' : ''} ·
              <strong>+$<span id="extrasMonto">{costoExtras}</span> MXN</strong>
            </div>
          </div>
        </div>

        <div class="galeria-grid galeria-grid-seleccion">
          {fotosParaSeleccion.map((foto, i) => (
            <figure
              class={`galeria-item galeria-item-selectable ${seleccionadas.has(foto.id) ? 'selected' : ''}`}
              data-foto-id={foto.id}
              data-index={i}
            >
              <div class="galeria-frame">
                <img
                  src={fotoUrl(env, foto.r2_key)}
                  alt={`Foto ${i + 1} de la sesión de ${sesion.nombre_cliente}`}
                  loading="lazy"
                  draggable="false"
                  data-full={fotoUrl(env, foto.r2_key)}
                />
                <button
                  class="galeria-zoom"
                  type="button"
                  aria-label={`Ver la foto ${i + 1} en grande`}
                >⤢</button>
                <span class="check-mark" aria-hidden="true">✓</span>
              </div>
              <figcaption class="galeria-caption">
                {String(i + 1).padStart(2, '0')} / {String(fotosParaSeleccion.length).padStart(2, '0')}
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="confirmar-bar">
          <button id="btnConfirmar" class="btn-confirmar" type="button" disabled={seleccionadasCount === 0}>
            Confirmar selección
            {extras > 0 && ` y pagar $${costoExtras} MXN`}
          </button>
        </div>
      </section>
    )}

    {sesion.estado === 'pago_pendiente' && (
      sesion.comprobante_50_url ? (
        <section class="estado-pendiente" data-codigo={sesion.codigo}>
          <p class="estado-eyebrow">Pago en revisión</p>
          <p class="estado-titulo">Recibimos tu comprobante</p>
          <p class="estado-texto">
            Lo estamos verificando. En cuanto confirmemos el pago, pasamos a edición y te avisamos por correo.
          </p>
          <p class="estado-meta">
            <a href={sesion.comprobante_50_url} target="_blank" rel="noopener">Ver el comprobante que subiste ↗</a>
          </p>
          <button id="btnReemplazarComp" type="button" class="btn-ghost-cliente">Subir otro comprobante</button>
          <p id="compMsg" class="form-msg" aria-live="polite"></p>
          <input id="compFileInput" type="file" accept="image/jpeg,image/png,application/pdf" hidden />
        </section>
      ) : (
        <section class="estado-pago" data-codigo={sesion.codigo}>
          <p class="estado-eyebrow">Pago de extras</p>
          <p class="estado-titulo">Sube tu comprobante de pago</p>
          <p class="estado-texto">
            Recibimos tu selección. Elegiste <strong>{extras} foto{extras !== 1 ? 's' : ''} extra</strong> ·
            total a pagar <strong>${Number(sesion.monto_extras ?? costoExtras)} MXN</strong>.
          </p>

          <div class="pago-instrucciones">
            <p class="pago-instrucciones-label">Cómo pagar</p>
            <p>
              Manda el monto por transferencia, depósito o Mercado Pago. Si no tienes los datos,
              <a href={waPagoUrl} target="_blank" rel="noopener">pídenoslos por WhatsApp</a>.
            </p>
            <p>Cuando hagas la transferencia, sube aquí el comprobante (foto o PDF).</p>
          </div>

          <div id="compDropzone" class="cliente-dropzone">
            <p class="dropzone-text">Arrastra tu comprobante o haz click</p>
            <p class="dropzone-sub">JPG, PNG o PDF · máximo 8 MB</p>
            <input id="compFileInput" type="file" accept="image/jpeg,image/png,application/pdf" hidden />
          </div>
          <p id="compMsg" class="form-msg" aria-live="polite"></p>
        </section>
      )
    )}

    {sesion.estado === 'archivada' && (
      <section class="estado-archivada">
        <p class="estado-titulo">Esta sesión fue archivada</p>
        <p class="estado-texto">
          Tus fotos estuvieron disponibles 30 días después de la entrega
          {sesion.fecha_archivado && ` y se archivaron el ${new Date(sesion.fecha_archivado).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })}`}.
          Los archivos ya no están en línea, pero tu información sigue guardada.
        </p>
        <p class="estado-texto" style="margin-top:1.5rem">
          Si necesitas que reactivemos tu galería, escríbenos por WhatsApp o correo y lo arreglamos.
        </p>
        <div class="archivada-actions">
          <a class="btn-archivada" href={waArchivadaUrl} target="_blank" rel="noopener">
            Escribir por WhatsApp
          </a>
          <a class="btn-archivada btn-archivada-ghost" href={mailArchivadaUrl}>
            Escribir por correo
          </a>
        </div>
      </section>
    )}

    {sesion.estado === 'lead' && (
      <section class="estado-pendiente">
        <p class="estado-titulo">Estamos preparando tu sesión</p>
        <p class="estado-texto">
          Recibimos tu solicitud por el formulario y te vamos a contactar pronto para confirmar fecha y detalles.
          Vuelve a esta página con el código que te enviemos por WhatsApp o correo.
        </p>
      </section>
    )}

    {sesion.estado === 'editando' && (
      <section class="estado-editando">
        <p class="estado-titulo">Estamos editando tus fotos</p>
        <p class="estado-texto">
          Recibimos tu selección{sesion.fecha_confirmacion ? ` el ${new Date(sesion.fecha_confirmacion).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' })}` : ''}.
          Vuelve aquí cuando recibas el correo de "tus fotos están listas" para descargarlas.
        </p>

        <details class="seleccion-resumen">
          <summary>Ver mi selección ({selecciones.length} foto{selecciones.length !== 1 ? 's' : ''})</summary>
          <div class="galeria-grid galeria-grid-readonly">
            {fotosParaSeleccion
              .filter((f) => seleccionadas.has(f.id))
              .map((foto, i) => (
                <figure class="galeria-item">
                  <div class="galeria-frame">
                    <img
                      src={fotoUrl(env, foto.r2_key)}
                      alt={`Selección ${i + 1}`}
                      loading="lazy"
                      draggable="false"
                    />
                  </div>
                </figure>
              ))}
          </div>
        </details>
      </section>
    )}
  </main>

  <div
    id="lightbox"
    class="lightbox"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Foto ampliada"
  >
    <button class="lightbox-close" aria-label="Cerrar">×</button>
    <button class="lightbox-prev" aria-label="Anterior">‹</button>
    <img id="lightboxImg" src="" alt="" />
    <button class="lightbox-next" aria-label="Siguiente">›</button>
    <div class="lightbox-counter" id="lightboxCounter"></div>
  </div>

  <style is:global>
    .cliente-main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 8rem 2rem 4rem;
    }

    .cliente-intro {
      margin-bottom: 3rem;
      text-align: center;
    }
    .cliente-eyebrow {
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .cliente-name {
      font-family: var(--f-serif);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 300;
      letter-spacing: 0.02em;
      margin-bottom: 0.6rem;
    }
    .cliente-paquete {
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-transform: uppercase;
    }

    /* GALERIA GRID */
    .galeria-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-top: 2rem;
    }
    .galeria-grid-readonly { gap: 1.2rem; margin-top: 1.5rem; }

    .galeria-item {
      position: relative;
      transition: opacity 0.3s;
    }
    .galeria-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      background: var(--char);
    }
    .galeria-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: zoom-in;
      transition: transform 0.4s ease, filter 0.3s;
      -webkit-user-drag: none;
      user-select: none;
    }
    .galeria-item:hover .galeria-frame img:not(.galeria-alt) { transform: scale(1.03); }

    .galeria-caption {
      margin-top: 0.6rem;
      font-family: var(--f-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-align: center;
      text-transform: uppercase;
    }

    /* DESCARGA (entregada) */
    .galeria-download {
      position: absolute;
      top: 0.7rem;
      right: 0.7rem;
      width: 2rem; height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(13,13,11,0.65);
      color: var(--paper);
      border: 0.5px solid rgba(245,242,237,0.3);
      text-decoration: none;
      font-family: var(--f-mono);
      font-size: 0.95rem;
      opacity: 0;
      transition: opacity 0.25s, background 0.2s;
    }
    .galeria-item:hover .galeria-download { opacity: 1; }
    .galeria-download:hover { background: var(--paper); color: var(--ink); }

    /* VERSIÓN ALTERNATIVA (subversión) */
    .galeria-frame img.galeria-alt {
      position: absolute;
      left: 0.7rem;
      bottom: 0.7rem;
      top: auto;
      width: 32%;
      height: auto;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
      cursor: zoom-in;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      transform-origin: bottom left;
      z-index: 2;
    }
    .galeria-frame img.galeria-alt:hover {
      transform: scale(1.8);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
      z-index: 3;
    }
    .galeria-download-alt {
      top: auto !important;
      bottom: 0.7rem;
      left: calc(0.7rem + 32% - 2.3rem);
      right: auto;
    }
    .galeria-caption-alt { color: var(--accent); }

    /* SELECCIÓN */
    .galeria-item-selectable .galeria-frame { cursor: pointer; }
    /* En selección el click selecciona, no amplía: la lupa dice zoom-in y
       mentía. El zoom vive en su propio botón. */
    .galeria-item-selectable .galeria-frame img { cursor: pointer; }
    .galeria-zoom {
      position: absolute;
      top: 0.7rem;
      left: 0.7rem;
      width: 2rem; height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(13,13,11,0.65);
      color: var(--paper);
      border: 0.5px solid rgba(245,242,237,0.3);
      font-family: var(--f-mono);
      font-size: 0.85rem;
      line-height: 1;
      opacity: 0;
      cursor: pointer;
      transition: opacity 0.25s, background 0.2s;
    }
    .galeria-item:hover .galeria-zoom,
    .galeria-zoom:focus-visible { opacity: 1; }
    .galeria-zoom:hover { background: var(--paper); color: var(--ink); }
    .galeria-item-selectable .check-mark {
      position: absolute;
      top: 0.7rem;
      right: 0.7rem;
      width: 2rem; height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--paper);
      color: var(--ink);
      font-size: 1rem;
      opacity: 0;
      transform: scale(0.6);
      transition: opacity 0.2s, transform 0.2s;
    }
    .galeria-item-selectable.selected .check-mark {
      opacity: 1;
      transform: scale(1);
    }
    .galeria-item-selectable.selected .galeria-frame { outline: 2px solid var(--paper); outline-offset: 4px; }
    .galeria-item-selectable.selected .galeria-frame img { filter: brightness(0.7); }

    /* CONTADOR (selección) */
    .seleccion-status {
      position: sticky;
      /* El nav es fixed y transparente: con top:1rem esta barra se le metía
         debajo al hacer scroll y los enlaces caían encima del contador. */
      top: calc(var(--nav-h) + 0.5rem);
      z-index: 50;
      background: var(--ink);
      padding: 1.25rem 1.5rem;
      border: 0.5px solid rgba(245,242,237,0.12);
      margin-bottom: 2rem;
    }
    .seleccion-instructions {
      font-family: var(--f-sans);
      font-size: var(--fs-body);
      color: var(--mist);
      margin-bottom: 0.8rem;
      line-height: 1.6;
    }
    .seleccion-instructions strong { color: var(--paper); }
    .contador-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--paper);
    }
    .contador-extras { color: var(--accent); }
    .contador-extras strong { color: var(--paper); }

    .confirmar-bar {
      margin-top: 3rem;
      display: flex;
      justify-content: center;
    }
    .btn-confirmar {
      padding: 1rem 3rem;
      background: var(--paper);
      color: var(--ink);
      border: none;
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s, opacity 0.2s;
    }
    .btn-confirmar:hover { background: var(--accent); }
    .btn-confirmar:disabled { opacity: 0.4; pointer-events: none; }

    /* ESTADOS NO INTERACTIVOS */
    /* ESTADO PAGO (cliente sube comprobante) */
    .estado-pago {
      max-width: 640px;
      margin: 3rem auto;
      padding: 2.5rem 2rem;
      border: 0.5px solid rgba(245,242,237,0.12);
      background: rgba(245,242,237,0.02);
    }
    .estado-eyebrow {
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 0.8rem;
    }
    .estado-pago .estado-titulo {
      font-family: var(--f-serif);
      font-size: 1.6rem;
      margin-bottom: 1rem;
      color: var(--paper);
    }
    .estado-pago .estado-texto {
      font-family: var(--f-sans);
      color: var(--mist);
      line-height: 1.7;
      margin-bottom: 1.2rem;
    }
    .estado-pago .estado-texto strong { color: var(--paper); }
    .pago-instrucciones {
      margin: 1.5rem 0 1.8rem;
      padding: 1.2rem 1.4rem;
      background: rgba(13,13,11,0.6);
      border-left: 2px solid var(--accent);
    }
    .pago-instrucciones-label {
      font-family: var(--f-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }
    .pago-instrucciones p {
      font-family: var(--f-sans);
      font-size: var(--fs-body);
      color: var(--mist);
      line-height: 1.6;
      margin-bottom: 0.5rem;
    }
    .pago-instrucciones p:last-child { margin-bottom: 0; }
    .pago-instrucciones a {
      color: var(--paper);
      text-decoration: underline;
    }
    .cliente-dropzone {
      padding: 2.2rem 1.4rem;
      border: 1px dashed rgba(245,242,237,0.25);
      background: rgba(245,242,237,0.02);
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }
    .cliente-dropzone:hover,
    .cliente-dropzone.drag-over {
      border-color: var(--paper);
      background: rgba(245,242,237,0.05);
    }
    .cliente-dropzone .dropzone-text {
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--paper);
      margin-bottom: 0.4rem;
    }
    .cliente-dropzone .dropzone-sub {
      font-family: var(--f-mono);
      font-size: var(--fs-micro);
      color: var(--ash);
    }
    .form-msg {
      margin-top: 1rem;
      font-family: var(--f-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--ash);
    }
    .form-msg.ok { color: #9bc59b; }
    .form-msg.error { color: #e07070; }
    .btn-ghost-cliente {
      margin-top: 1rem;
      padding: 0.7rem 1.4rem;
      background: transparent;
      border: 0.5px solid rgba(245,242,237,0.3);
      color: var(--paper);
      font-family: var(--f-mono);
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-ghost-cliente:hover {
      background: rgba(245,242,237,0.06);
      border-color: var(--paper);
    }
    .estado-meta {
      font-family: var(--f-mono);
      font-size: var(--fs-micro);
      color: var(--ash);
      letter-spacing: 0.04em;
      margin-top: 1rem;
    }
    .estado-meta a {
      color: var(--paper);
      text-decoration: underline;
    }

    .estado-pendiente, .estado-editando, .estado-archivada {
      max-width: 600px;
      margin: 4rem auto;
      text-align: center;
      padding: 2.5rem;
      border: 0.5px solid rgba(245,242,237,0.12);
    }
    .archivada-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-top: 2rem;
      flex-wrap: wrap;
    }
    .btn-archivada {
      padding: 0.85rem 1.6rem;
      background: var(--paper);
      color: var(--ink);
      border: none;
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-archivada:hover { background: var(--accent); }
    .btn-archivada-ghost {
      background: transparent;
      color: var(--paper);
      border: 0.5px solid rgba(245,242,237,0.3);
    }
    .btn-archivada-ghost:hover {
      background: rgba(245,242,237,0.05);
      border-color: var(--paper);
    }
    .estado-titulo {
      font-family: var(--f-serif);
      font-size: 1.4rem;
      margin-bottom: 1rem;
      color: var(--paper);
    }
    .estado-texto {
      font-family: var(--f-sans);
      color: var(--mist);
      line-height: 1.7;
      font-size: var(--fs-body);
    }
    .estado-entregada > .estado-texto {
      text-align: center;
      max-width: 600px;
      margin: 0 auto 2rem;
    }
    .seleccion-resumen { margin-top: 2rem; text-align: left; }
    .seleccion-resumen summary {
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-transform: uppercase;
      cursor: pointer;
      padding: 0.6rem 0;
    }
    .seleccion-resumen summary:hover { color: var(--paper); }

    /* LIGHTBOX */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(13,13,11,0.96);
    }
    .lightbox[hidden] { display: none; }
    .lightbox img {
      max-width: 92vw;
      max-height: 88vh;
      object-fit: contain;
      -webkit-user-drag: none;
      user-select: none;
    }
    .lightbox-close, .lightbox-prev, .lightbox-next {
      position: absolute;
      background: transparent;
      border: 0.5px solid rgba(245,242,237,0.3);
      color: var(--paper);
      font-size: 1.6rem;
      width: 3rem; height: 3rem;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }
    .lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover {
      background: rgba(245,242,237,0.1);
      border-color: var(--paper);
    }
    .lightbox-close { top: 1.5rem; right: 1.5rem; }
    .lightbox-prev  { left: 1.5rem;  top: 50%; transform: translateY(-50%); }
    .lightbox-next  { right: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lightbox-counter {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      color: var(--ash);
      text-transform: uppercase;
    }

    /* El cursor personalizado solo existe con ratón fino (global.css lo scopea
       igual). Sin este media query estos botones se quedaban sin puntero en
       táctil e híbridos, y también si el JS del cursor fallaba. */
    @media (hover: hover) and (pointer: fine) {
      .btn-confirmar,
      .btn-archivada,
      .galeria-zoom,
      .lightbox-close,
      .lightbox-prev,
      .lightbox-next { cursor: none; }
    }

    @media (max-width: 768px) {
      .cliente-main { padding: 6.5rem 1.2rem 3rem; }
      .galeria-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .seleccion-status { padding: 1rem 1.1rem; }
      .contador-bar { font-size: var(--fs-micro); }
      .galeria-download, .galeria-zoom { opacity: 1; }
    }
  </style>

  <script>
    (() => {
      // ─── Lightbox ────────────────────────────────────
      const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
      const lbImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
      const lbCounter = document.getElementById('lightboxCounter') as HTMLDivElement | null;
      const lbClose = document.querySelector<HTMLButtonElement>('.lightbox-close');
      const lbPrev = document.querySelector<HTMLButtonElement>('.lightbox-prev');
      const lbNext = document.querySelector<HTMLButtonElement>('.lightbox-next');
      // Solo las imágenes "principales" se navegan con flechas/contador.
      // Las alt (.galeria-alt) se abren en standalone (sin nav, contador especial).
      const items = Array.from(
        document.querySelectorAll<HTMLImageElement>('.galeria-frame img[data-full]:not(.galeria-alt)'),
      );
      const altItems = Array.from(
        document.querySelectorAll<HTMLImageElement>('.galeria-frame img.galeria-alt[data-full]'),
      );
      let currentIdx = 0;
      let inAltMode = false;

      const setNavVisible = (visible: boolean) => {
        if (lbPrev) lbPrev.style.display = visible ? '' : 'none';
        if (lbNext) lbNext.style.display = visible ? '' : 'none';
      };

      let lastFocused: HTMLElement | null = null;

      // Solo al entrar: pasar de foto con las flechas no debe robarle el foco
      // al botón que estás pulsando ni reapilar el scroll-lock.
      const enterLightbox = () => {
        lastFocused = document.activeElement as HTMLElement | null;
        // Mismo bloqueo que usa el menú móvil: sin esto la página seguía
        // scrolleando detrás de la foto ampliada.
        document.documentElement.toggleAttribute('data-scroll-lock', true);
      };

      const openLightbox = (i: number, entering = true) => {
        if (!lightbox || !lbImg || !lbCounter) return;
        if (entering) enterLightbox();
        inAltMode = false;
        currentIdx = i;
        lbImg.src = items[i].dataset.full ?? items[i].src;
        lbImg.alt = items[i].alt;
        lbCounter.textContent = `${String(i + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
        setNavVisible(items.length > 1);
        lightbox.hidden = false;
        if (entering) lbClose?.focus();
      };
      const openAlt = (img: HTMLImageElement) => {
        if (!lightbox || !lbImg || !lbCounter) return;
        enterLightbox();
        inAltMode = true;
        lbImg.src = img.dataset.full ?? img.src;
        lbImg.alt = img.alt;
        lbCounter.textContent = 'Versión alterna';
        setNavVisible(false);
        lightbox.hidden = false;
        lbClose?.focus();
      };
      const closeLightbox = () => {
        if (!lightbox || lightbox.hidden) return;
        lightbox.hidden = true;
        document.documentElement.toggleAttribute('data-scroll-lock', false);
        // Sin esto el foco cae al principio del documento al cerrar.
        lastFocused?.focus();
        lastFocused = null;
      };
      const nav = (delta: number) => {
        if (inAltMode || items.length === 0) return;
        openLightbox((currentIdx + delta + items.length) % items.length, false);
      };

      items.forEach((img, i) => {
        // En selección el click en la foto la elige; abrir además el lightbox
        // hacía que ampliar una foto la seleccionara sin querer.
        const selectable = img.closest('.galeria-item-selectable');
        if (selectable) {
          selectable.querySelector('.galeria-zoom')?.addEventListener('click', (e) => {
            e.stopPropagation();
            openLightbox(i);
          });
        } else {
          img.addEventListener('click', () => openLightbox(i));
        }
      });
      altItems.forEach((img) => {
        img.addEventListener('click', (e) => {
          e.stopPropagation();
          openAlt(img);
        });
      });

      lbClose?.addEventListener('click', closeLightbox);
      document.querySelector('.lightbox-prev')?.addEventListener('click', () => nav(-1));
      document.querySelector('.lightbox-next')?.addEventListener('click', () => nav(1));
      document.addEventListener('keydown', (e) => {
        if (lightbox?.hidden) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') nav(-1);
        if (e.key === 'ArrowRight') nav(1);
        if (e.key !== 'Tab') return;
        // Trampa de foco: es un diálogo modal, tabular fuera te dejaba
        // recorriendo la galería de atrás sin poder ver dónde estabas.
        const focusables = [lbClose, lbPrev, lbNext].filter(
          (el): el is HTMLButtonElement => !!el && el.offsetParent !== null,
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const dentro = focusables.includes(document.activeElement as HTMLButtonElement);
        if (e.shiftKey && (!dentro || document.activeElement === first)) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (!dentro || document.activeElement === last)) {
          e.preventDefault();
          first.focus();
        }
      });
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      // Swipe horizontal: en táctil las flechas quedan pegadas al borde y
      // encima de la foto, así que pasar de imagen era incómodo.
      let touchX = 0;
      let touchY = 0;
      lightbox?.addEventListener('touchstart', (e) => {
        touchX = e.changedTouches[0].clientX;
        touchY = e.changedTouches[0].clientY;
      }, { passive: true });
      lightbox?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        const dy = e.changedTouches[0].clientY - touchY;
        // Solo gestos claramente horizontales, para no robarle el toque a un
        // scroll vertical ni a un tap en el fondo para cerrar.
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) nav(dx < 0 ? 1 : -1);
      }, { passive: true });

      // ─── Subir comprobante (cliente, pago_pendiente) ────
      const compSection = document.querySelector<HTMLElement>('.estado-pago, .estado-pendiente[data-codigo]');
      if (compSection) {
        const codigo = compSection.dataset.codigo!;
        const compInput = document.getElementById('compFileInput') as HTMLInputElement | null;
        const compDropzone = document.getElementById('compDropzone');
        const compMsg = document.getElementById('compMsg');
        const btnReemplazar = document.getElementById('btnReemplazarComp');

        const subirComprobante = async (file: File) => {
          if (!compMsg) return;
          if (file.size > 8 * 1024 * 1024) {
            compMsg.textContent = 'El archivo excede 8 MB. Compáctalo y vuelve a intentar.';
            compMsg.className = 'form-msg error';
            return;
          }
          compMsg.textContent = `Subiendo ${file.name}...`;
          compMsg.className = 'form-msg';
          const fd = new FormData();
          fd.set('codigo', codigo);
          fd.set('file', file);
          try {
            const res = await fetch('/api/upload-comprobante', { method: 'POST', body: fd });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) {
              compMsg.textContent = j.error || `Error ${res.status}`;
              compMsg.className = 'form-msg error';
              return;
            }
            compMsg.textContent = 'Listo. Te avisamos cuando lo verifiquemos.';
            compMsg.className = 'form-msg ok';
            setTimeout(() => window.location.reload(), 900);
          } catch (e) {
            compMsg.textContent = String(e);
            compMsg.className = 'form-msg error';
          }
        };

        compDropzone?.addEventListener('click', () => compInput?.click());
        compDropzone?.addEventListener('dragover', (e) => {
          e.preventDefault();
          compDropzone.classList.add('drag-over');
        });
        compDropzone?.addEventListener('dragleave', () => compDropzone.classList.remove('drag-over'));
        compDropzone?.addEventListener('drop', (e) => {
          e.preventDefault();
          compDropzone.classList.remove('drag-over');
          const f = e.dataTransfer?.files?.[0];
          if (f) subirComprobante(f);
        });
        btnReemplazar?.addEventListener('click', () => compInput?.click());
        compInput?.addEventListener('change', () => {
          const f = compInput.files?.[0];
          if (f) subirComprobante(f);
        });
      }
      // ─── Selección ───────────────────────────────────
      const seccion = document.querySelector<HTMLElement>('.estado-seleccion');
      if (!seccion) return;

      const sesionId = seccion.dataset.sesionId!;
      const limite = parseInt(seccion.dataset.limite ?? '0', 10);
      const precioExtra = parseFloat(seccion.dataset.precioExtra ?? '0');

      const contadorEl = document.getElementById('contadorActual')!;
      const extrasInfo = document.getElementById('extrasInfo')!;
      const extrasCount = document.getElementById('extrasCount')!;
      const extrasMonto = document.getElementById('extrasMonto')!;
      const btnConfirmar = document.getElementById('btnConfirmar') as HTMLButtonElement;

      const refresh = () => {
        const seleccionadas = document.querySelectorAll('.galeria-item-selectable.selected').length;
        contadorEl.textContent = String(seleccionadas);

        const extras = Math.max(0, seleccionadas - limite);
        const monto = extras * precioExtra;
        extrasCount.textContent = String(extras);
        extrasMonto.textContent = String(monto);
        extrasInfo.style.display = extras > 0 ? '' : 'none';

        btnConfirmar.disabled = seleccionadas === 0;
        btnConfirmar.textContent = extras > 0
          ? `Confirmar selección y pagar $${monto} MXN`
          : 'Confirmar selección';
      };

      document.querySelectorAll<HTMLElement>('.galeria-item-selectable').forEach((item) => {
        const fotoId = item.dataset.fotoId!;
        const frame = item.querySelector('.galeria-frame');
        // Click en la foto (excluyendo el download): toggle selección
        frame?.addEventListener('click', async (e) => {
          e.preventDefault();
          item.classList.toggle('selected');
          refresh();

          try {
            const res = await fetch('/api/seleccionar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sesionId, fotoId }),
            });
            if (!res.ok) throw new Error('Error al guardar');
          } catch (err) {
            // Revertir UI
            item.classList.toggle('selected');
            refresh();
            console.error(err);
            alert('No se pudo guardar la selección. Intenta de nuevo.');
          }
        });
      });

      btnConfirmar?.addEventListener('click', async () => {
        if (!confirm('¿Confirmar tu selección? Después de esto ya no podrás cambiarla.')) return;
        btnConfirmar.disabled = true;
        btnConfirmar.textContent = 'Procesando...';
        try {
          const res = await fetch('/api/confirmar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sesionId }),
          });
          if (!res.ok) throw new Error('Error al confirmar');
          const json = await res.json() as { redirect?: string };
          window.location.href = json.redirect ?? window.location.href;
        } catch (err) {
          console.error(err);
          alert('No se pudo confirmar. Intenta de nuevo.');
          btnConfirmar.disabled = false;
          refresh();
        }
      });

      refresh();

    })();
  </script>
</Layout>
