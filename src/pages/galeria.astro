---
import Layout from '../layouts/Layout.astro';
import { PRECIO_DESDE, formatMXN } from '../lib/precios';
import type { ImageGallery, WithContext } from 'schema-dts';

const desde = formatMXN(PRECIO_DESDE);

// `label` es el texto que aparece al pasar el cursor (no cambia lo visual);
// `alt` es la descripción para Google Imágenes y lectores de pantalla.
const tipos: Record<string, string> = {
  profesional: 'Retrato profesional',
  corporativo: 'Retrato corporativo',
  editorial: 'Retrato editorial',
  personal: 'Retrato personal',
  artistico: 'Retrato artístico',
};
const fotos = [
  ['profesional', 'ricardo', 'Ricardo', 533],
  ['editorial', 'ricardo', 'Ricardo', 529],
  ['profesional', 'jonathan', 'Jonathan', 522],
  ['corporativo', 'jonathan', 'Jonathan', 528],
  ['profesional', 'valeria', 'Valeria', 639],
  ['personal', 'mafer-2', 'Mafer', 508],
  ['corporativo', 'carlos', 'Carlos', 642],
  ['profesional', 'carlos', 'Carlos', 641],
  ['editorial', 'carlos', 'Carlos', 532],
  ['artistico', 'michelle', 'Michelle', 533],
  ['personal', 'michelle', 'Michelle', 664],
  ['profesional', 'christian', 'Christian', 640],
  ['editorial', 'christian', 'Christian', 533],
  ['profesional', 'javier', 'Javier', 640],
  ['editorial', 'javier', 'Javier', 563],
  ['profesional', 'eli', 'Eli', 640],
  ['profesional', 'eli-2', 'Eli', 640],
] as const;
const images = fotos.map(([tipo, archivo, nombre, width]) => ({
  src: `/img/thumb/retrato-${tipo}-${archivo}.webp`,
  label: `${tipos[tipo]} · ${nombre}`,
  alt: `${tipos[tipo]} de ${nombre} en el estudio de ANTE en Coyoacán, CDMX`,
  width,
  height: 800,
}));

const siteUrl = 'https://www.ante.photo';
const ante = { '@id': `${siteUrl}/#ante` } as const;
const gallerySchema: WithContext<ImageGallery> = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Retrato profesional para abogados y profesionistas · ANTE',
  description: 'Retratos profesionales, corporativos y editoriales hechos por ANTE Retrato Profesional en su estudio de Coyoacán, Ciudad de México.',
  url: `${siteUrl}/galeria`,
  inLanguage: 'es-MX',
  about: { '@type': 'Service', name: 'Retrato profesional', serviceType: 'Retrato profesional' },
  author: ante,
  image: images.map((img) => ({
    '@type': 'ImageObject',
    contentUrl: siteUrl + img.src,
    name: img.label,
    caption: img.alt,
    width: { '@type': 'QuantitativeValue', value: img.width, unitCode: 'E37' },
    height: { '@type': 'QuantitativeValue', value: img.height, unitCode: 'E37' },
    creator: ante,
    copyrightHolder: ante,
    creditText: 'ANTE Retrato Profesional',
    copyrightNotice: '© ANTE Retrato Profesional',
    contentLocation: { '@type': 'Place', name: 'Coyoacán, Ciudad de México' },
  })),
};
---
<Layout
  title="Galería de Retrato Profesional · Abogados y Profesionistas en CDMX | ANTE"
  description={`Retrato profesional para abogados, ejecutivos y profesionistas, hecho en nuestro estudio de Coyoacán, CDMX. Corporativos, books y editoriales. Agenda desde ${desde} MXN.`}
>
<!-- PAGE HEADER -->
<div class="page-header">
  <div>
    <p class="page-eyebrow">Trabajo reciente</p>
    <h1 class="page-title">Galería</h1>
    <p class="page-sub">Retratos hechos en nuestro estudio de Coyoacán, en la Ciudad de México: corporativos para LinkedIn y perfiles profesionales, books personales y trabajo editorial. Todo con la misma luz cuidada y la misma dirección de pose.</p>
  </div>
</div>

<!-- GALLERY -->
<section class="gallery-section" aria-label="Galería de retrato profesional ANTE">
  <div class="gallery-grid" id="gallery">
    {images.map((img) => (
      <div class="gallery-item">
        <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async">
        <div class="gallery-item-overlay"><span class="gallery-item-label">{img.label}</span></div>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<section class="gallery-cta">
  <p>¿Quieres el tuyo? Sesiones desde {desde} MXN, entrega en 3 a 5 días. <a href="/#precios">Ver paquetes</a>.</p>
  <a href="/agendar" class="btn-ghost">Agendar sesión <span class="arrow">→</span></a>
</section>

<!-- LIGHTBOX -->
<div id="lightbox" class="lightbox">
  <span class="lightbox-close" id="lightboxClose">Cerrar ×</span>
  <span class="lightbox-nav lightbox-prev" id="lightboxPrev">‹</span>
  <img id="lightboxImg" src="" alt="">
  <span class="lightbox-nav lightbox-next" id="lightboxNext">›</span>
</div>

<script type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

<style is:global>

    /* Los tokens viven en src/styles/global.css. */

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--ink);
      color: var(--paper);
      font-family: var(--f-sans);
      font-weight: 300;
      overflow-x: hidden;
      cursor: none;
    }

    .cursor {
      position: fixed;
      width: 8px; height: 8px;
      background: var(--paper);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: transform 0.1s ease, opacity 0.2s;
    }
    .cursor-ring {
      position: fixed;
      width: 36px; height: 36px;
      border: 0.5px solid var(--accent);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%, -50%);
      transition: transform 0.25s ease, width 0.2s, height 0.2s, opacity 0.2s;
    }

    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 4rem;
    }
    .nav-logo {
      font-family: 'Marion', Georgia, serif;
      font-size: 1.1rem;
      font-weight: 400;
      letter-spacing: var(--ls-wide);
      color: var(--paper);
      text-decoration: none;
      text-transform: uppercase;
    }
    .nav-links {
      display: flex;
      gap: 3rem;
      list-style: none;
    }
    .nav-links a {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-decoration: none;
      text-transform: uppercase;
      transition: color 0.3s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--paper); }

    /* PAGE HEADER */
    .page-header {
      padding: 14rem 4rem 4rem;
      border-bottom: 0.5px solid rgba(245,242,237,0.1);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .page-eyebrow {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: fadeup 1s 0.3s forwards;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .page-eyebrow::before {
      content: '';
      display: block;
      width: 24px; height: 0.5px;
      background: var(--accent);
    }
    .page-sub {
      font-size: var(--fs-body);
      font-weight: 300;
      color: var(--mist);
      line-height: 1.85;
      max-width: 560px;
      margin-top: 2rem;
      opacity: 0;
      animation: fadeup 1s 0.8s forwards;
    }
    .gallery-cta {
      padding: 4rem;
      border-top: 0.5px solid rgba(245,242,237,0.1);
      text-align: center;
    }
    .gallery-cta p {
      font-size: var(--fs-body);
      font-weight: 300;
      color: var(--mist);
      margin-bottom: 2rem;
    }
    .page-title {
      font-family: var(--f-serif);
      font-size: clamp(3.5rem, 8vw, 7rem);
      font-weight: 700;
      line-height: 1.0;
      letter-spacing: -0.01em;
      color: var(--paper);
      opacity: 0;
      animation: fadeup 1.2s 0.5s forwards;
    }

    /* GALLERY */
    .gallery-section {
      padding: 4rem;
    }
    .gallery-grid {
      columns: 4;
      column-gap: 1rem;
    }
    .gallery-item {
      break-inside: avoid;
      margin-bottom: 1rem;
      overflow: hidden;
      position: relative;
      cursor: pointer;
    }
    .gallery-item img {
      width: 100%;
      height: auto;
      display: block;
      filter: grayscale(0.15);
      transition: transform 0.6s ease, filter 0.4s;
    }
    .gallery-item:hover img {
      transform: scale(1.04);
      filter: grayscale(0);
    }
    .gallery-item-overlay {
      position: absolute;
      inset: 0;
      background: rgba(13,13,11,0);
      transition: background 0.4s;
      display: flex;
      align-items: flex-end;
      padding: 1.2rem;
    }
    .gallery-item:hover .gallery-item-overlay {
      background: rgba(13,13,11,0.35);
    }
    .gallery-item-label {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--paper);
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.3s, transform 0.3s;
    }
    .gallery-item:hover .gallery-item-label {
      opacity: 1;
      transform: translateY(0);
    }

    /* LIGHTBOX */
    .lightbox {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(13,13,11,0.92);
      backdrop-filter: blur(4px);
      z-index: 200;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .lightbox.show { opacity: 1; pointer-events: auto; }
    .lightbox img {
      max-width: 88vw;
      max-height: 88vh;
      object-fit: contain;
      display: block;
    }
    .lightbox-close {
      position: absolute;
      top: 2rem; right: 3rem;
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-transform: uppercase;
      cursor: pointer;
      transition: color 0.3s;
      user-select: none;
    }
    .lightbox-close:hover { color: var(--paper); }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--f-sans);
      font-size: 2rem;
      font-weight: 300;
      color: var(--ash);
      cursor: pointer;
      transition: color 0.3s;
      user-select: none;
      padding: 1rem;
    }
    .lightbox-nav:hover { color: var(--paper); }
    .lightbox-prev { left: 2rem; }
    .lightbox-next { right: 2rem; }

    /* FOOTER */
    footer {
      border-top: 0.5px solid rgba(245,242,237,0.08);
      padding: 3rem 4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-logo {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-label);
      letter-spacing: var(--ls-wide);
      color: var(--ash);
      text-transform: uppercase;
    }
    .footer-info {
      font-family: var(--f-mono);
      font-weight: 400;
      font-size: var(--fs-micro);
      letter-spacing: var(--ls-label);
      color: var(--ash);
      text-align: right;
      line-height: 1.9;
    }
    .footer-info a { color: var(--ash); text-decoration: none; transition: color 0.3s; }
    .footer-info a:hover { color: var(--paper); }

    @keyframes fadeup {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadein {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    @media (max-width: 1200px) {
      .gallery-grid { columns: 3; }
    }
    @media (max-width: 768px) {
      nav { padding: 1rem 1.5rem; }
      .nav-links { gap: 1.5rem; }
      .page-header { padding: 10rem 1.5rem 3rem; flex-direction: column; align-items: flex-start; gap: 1rem; }
      .gallery-section { padding: 2rem 1.5rem; }
      .gallery-grid { columns: 2; }
      footer { flex-direction: column; gap: 1.5rem; text-align: center; }
      .footer-info { text-align: center; }
      .lightbox-nav { display: none; }
    }
    @media (max-width: 480px) {
      .gallery-grid { columns: 1; }
    }
  
</style>

<script is:inline>
(() => {

  // Cursor
  const cursor = document.getElementById('cursor');
  const ring = document.getElementById('cursorRing');
  let mx = 0, my = 0, rx = 0, ry = 0;

  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    cursor.style.left = mx + 'px';
    cursor.style.top  = my + 'px';
  });

  function animateRing() {
    rx += (mx - rx) * 0.12;
    ry += (my - ry) * 0.12;
    ring.style.left = rx + 'px';
    ring.style.top  = ry + 'px';
    requestAnimationFrame(animateRing);
  }
  animateRing();

  document.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('mouseenter', () => {
      ring.style.width = '56px';
      ring.style.height = '56px';
      ring.style.borderColor = 'rgba(200,184,154,0.6)';
    });
    el.addEventListener('mouseleave', () => {
      ring.style.width = '36px';
      ring.style.height = '36px';
      ring.style.borderColor = 'var(--accent)';
    });
  });

  // Las fotos vienen en el HTML (para que Google las lea); aquí solo se
  // baraja el orden en pantalla, como antes.
  const gallery = document.getElementById('gallery');
  const items = [...gallery.children];
  for (let i = items.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [items[i], items[j]] = [items[j], items[i]];
  }
  items.forEach(item => gallery.appendChild(item));

  const images = items.map(item => {
    const el = item.querySelector('img');
    return { src: el.getAttribute('src'), alt: el.alt };
  });
  let currentIndex = 0;
  items.forEach((item, i) => item.addEventListener('click', () => openLightbox(i)));

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');

  function openLightbox(i) {
    currentIndex = i;
    lightboxImg.src = images[i].src;
    lightboxImg.alt = images[i].alt;
    lightbox.classList.add('show');
  }

  function closeLightbox() {
    lightbox.classList.remove('show');
  }

  function prevImage() {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.alt = images[currentIndex].alt;
  }

  function nextImage() {
    currentIndex = (currentIndex + 1) % images.length;
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.alt = images[currentIndex].alt;
  }

  lightboxClose.addEventListener('click', closeLightbox);
  lightboxPrev.addEventListener('click', prevImage);
  lightboxNext.addEventListener('click', nextImage);
  lightbox.addEventListener('click', e => { if (e.target === lightbox || e.target === lightboxImg) closeLightbox(); });

  document.addEventListener('keydown', e => {
    if (!lightbox.classList.contains('show')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevImage();
    if (e.key === 'ArrowRight') nextImage();
  });

})();
</script>

</Layout>
