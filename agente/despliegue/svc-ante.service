[Unit]
Description=svc-ante — agente de WhatsApp de ANTE (compartimento ante; ver servidor/doc/COMPARTIMENTOS.md)
Documentation=file:///koko/srv/ante/app/agente/LEEME.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=svc-ante
Group=ante
WorkingDirectory=/koko/srv/ante/app
ExecStart=/usr/bin/node /koko/srv/ante/app/agente/src/main.ts

# ── Secretos ────────────────────────────────────────────────────────────────
# Descifrados en un tmpfs que sólo lee este servicio ($CREDENTIALS_DIRECTORY);
# nunca en el entorno. Se siembran con agente/despliegue/PARA-ROOT.md, paso 2.
# ADMIN_WHATSAPP_TO va aquí aunque no sea una llave: es el teléfono de Pablo y
# este archivo vive en un repositorio público.
LoadCredentialEncrypted=TWILIO_ACCOUNT_SID:/etc/ante/credenciales/TWILIO_ACCOUNT_SID.cred
LoadCredentialEncrypted=TWILIO_AUTH_TOKEN:/etc/ante/credenciales/TWILIO_AUTH_TOKEN.cred
LoadCredentialEncrypted=DEEPSEEK_API_KEY:/etc/ante/credenciales/DEEPSEEK_API_KEY.cred
LoadCredentialEncrypted=ADMIN_WHATSAPP_TO:/etc/ante/credenciales/ADMIN_WHATSAPP_TO.cred

# ── Lo que no es secreto ───────────────────────────────────────────────────
# Modo sondeo: el servicio sólo SALE a internet (api.twilio.com y
# api.deepseek.com); no escucha nada. Para webhook, ver PARA-ROOT.md §«Para
# pasar a webhook» (AGENTE_MODO=webhook, AGENTE_URL_PUBLICA=…, y un túnel).
Environment=AGENTE_MODO=sondeo
Environment=AGENTE_SONDEO_MS=5000
Environment=AGENTE_HOST=127.0.0.1
Environment=AGENTE_PUERTO=9186
Environment=AGENTE_DATOS=/koko/srv/ante/datos/agente
# Proveedor explícito: si falta la llave, el servicio NO arranca (en vez de
# contestarle a clientes reales con el simulado).
Environment=AGENTE_PROVEEDOR=deepseek
Environment=AGENTE_MODELO=deepseek-flash
Environment=AGENTE_TOPE_DIARIO_USD=0.50
Environment=AGENTE_MAX_TOKENS=400
Environment=AGENTE_TIEMPO_MODELO_MS=20000
Environment=AGENTE_PRESENTARSE=si
# Número compartido del Sandbox de Twilio (público; https://www.twilio.com/docs/whatsapp/sandbox).
# Con número propio aprobado, cámbialo y baja AGENTE_ENVIO_INTERVALO_MS.
Environment=TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
Environment=AGENTE_ENVIO_INTERVALO_MS=3000
Environment=AGENTE_LIMITE_POR_NUMERO_HORA=20
Environment=AGENTE_LIMITE_GLOBAL_HORA=200
Environment=AGENTE_RETENCION_DIAS=30
Environment=TZ=America/Mexico_City
Environment=NODE_ENV=production

# ── Blindaje (el de la plantilla, entero) ──────────────────────────────────
ReadWritePaths=/koko/srv/ante/datos
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# ── Blindaje añadido ───────────────────────────────────────────────────────
# Red: IPv4/IPv6 para salir a Twilio y DeepSeek; AF_UNIX para el journal y
# systemd. AF_NETLINK no hace falta a Node.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module @clock
SystemCallErrorNumber=EPERM
UMask=0077
# Node usa JIT: MemoryDenyWriteExecute=yes lo ROMPE (V8 necesita páginas
# escribibles y ejecutables). No se pone a propósito.
# ProcSubset=pid tampoco: Node lee /proc/cpuinfo y /proc/meminfo al arrancar.
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024

Restart=on-failure
RestartSec=30
# 78 = configuración incompleta (falta un secreto, host no permitido…): no se
# reintenta en bucle, se arregla la configuración.
RestartPreventExitStatus=78
