# Supabase (BD)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Cloudflare R2 (fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ante-sesiones
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# PayPal (pagos extras)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Correo (Resend para notificaciones)
# Sin RESEND_API_KEY los envíos hacen no-op (no rompen nada).
# MAIL_FROM debe ser un dominio verificado en Resend (ej: "ANTE <hola@ante.photo>").
RESEND_API_KEY=
MAIL_FROM=ANTE <contacto@ante.photo>
ADMIN_EMAIL=contacto@ante.photo
ADMIN_LOGIN_EMAIL=priormyt99@gmail.com

# WhatsApp al admin (Twilio Sandbox o número aprobado)
# Sin todos los TWILIO_* + ADMIN_WHATSAPP_TO, el envío hace no-op.
# Sandbox: https://console.twilio.com → Messaging → Try it out → Send WhatsApp.
# El admin manda al número de sandbox "join <code>" desde su WhatsApp una vez,
# y a partir de ahí recibe los mensajes que enviemos desde aquí.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+525951220554

# Notion (sync unidireccional CRM → Notion)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notion webhook (Estado bidireccional Notion → Supabase). Se obtiene tras
# verificar el webhook en la UI de la integración (ver logs del primer POST).
NOTION_WEBHOOK_TOKEN=

# URL pública del sitio (usada en "Link de Entrega" de Notion)
PUBLIC_SITE_URL=https://www.ante.photo
